# =============================================================================
# MUNCH Context Protocol — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is excluded by .gitignore.
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys (required for agent execution)
# ---------------------------------------------------------------------------
# Anthropic API key — needed for Claude-based agent tasks
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Claude Flow Configuration
# ---------------------------------------------------------------------------
# These are set automatically by .devcontainer and .mcp.json.
# Override here only if running outside Codespaces/devcontainer.
CLAUDE_FLOW_MODE=v3
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TOPOLOGY=hierarchical-mesh
CLAUDE_FLOW_MAX_AGENTS=15
CLAUDE_FLOW_MEMORY_BACKEND=hybrid
